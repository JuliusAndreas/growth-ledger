# Copy to .env and fill in. Never commit .env.

# Signs the session cookie. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Sign-in for the admin account.
ADMIN_USERNAME=admin
# Generate with: cd backend && python -m app.hashpw
#   or with Docker: docker compose run --rm -it growth-ledger python -m app.hashpw
ADMIN_PASSWORD_HASH=

# Set to true when the app is served over HTTPS (behind a reverse proxy with TLS).
COOKIE_SECURE=false

# Optional. Defaults: data/growth-ledger.db in the repo (local run), /data/growth-ledger.db (Docker).
# DATABASE_PATH=
